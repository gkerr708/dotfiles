# Sensitive files
home/.ssh/
home/.gnupg/
home/.netrc
home/.env

# Application caches and state
home/.cache/
home/.local/share/

# Secrets / credentials
*.secret
*.key
*.pem
home/.secrets
home/.config/tmux/plugins/

# Backup files created by setup-arch.sh — never commit these
**/*.bak
home/.config/tmux/plugins/

# Generated preview images from matplotlib-demo/preview.py
matplotlib-demo/*.png

# nchat runtime state — sessions, message history, logs (only *.conf is tracked)
home/.config/nchat/*
!home/.config/nchat/*.conf
