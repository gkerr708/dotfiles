# Sensitive files
home/.ssh/
home/.gnupg/
home/.netrc
home/.env

# Application caches and state
home/.cache/
home/.local/share/

# Secrets / credentials
*.secret
*.key
*.pem
home/.secrets

# Backup files created by setup/arch.sh — never commit these
**/*.bak

# tmux plugins (installed by tpm)
home/.config/tmux/plugins/

# Generated files
__pycache__/
home/.config/nvim/spell/*.spl

# App runtime state written into stowed (folded) dirs
home/.config/ncspot/userstate.cbor

# nchat runtime state — sessions, message history, logs (only *.conf is tracked)
home/.config/nchat/*
!home/.config/nchat/*.conf
