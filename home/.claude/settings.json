{
  "model": "sonnet",
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-speak-hook"
          }
        ]
      }
    ]
  }
}
