# ~/.visidatarc — VisiData configuration (Python)
# Docs: https://visidata.org/docs/options/  |  in-app: Space -> "open-config"

from visidata import vd, options

# ── Theme: Rosé Pine (black background) ──────────────────────────────────────
# Matches the Rosé Pine theme used by kitty/yazi/starship/nvim elsewhere in
# this repo. kitty's current-theme.conf remaps terminal ANSI colors 0-15 to
# the Rosé Pine palette (see ~/.config/kitty/current-theme.conf), so
# referencing those color numbers here — rather than the 256-color cube,
# which kitty leaves unmapped — renders the exact Rosé Pine hex values.
#   0/8  = Overlay / Muted       3/11 = Gold      6/14 = Rose
#   1/9  = Love (red)            4/12 = Foam       7   = Subtle
#   2/10 = Pine (green)          5/13 = Iris       15  = Text
# '' (unset) falls through to the terminal's true default fg/bg, i.e. exact
# Rosé Pine Text-on-Base, so the sheet blends with the rest of the terminal.
# Cursor row/col intentionally avoid 'reverse' and bold/underline: VisiData
# ORs attributes from every overlapping rule unconditionally (no way to
# clear a bit once set), so any attribute on current_row or current_col
# would still show up at their intersection no matter what current_cell
# does. Keeping row/col as plain, attribute-free bg tints — and using
# color_current_cell (precedence 3, beats both) to force the crosshair back
# to color16 (Base, see kitty.conf) — is what lets the actual selected cell
# render with zero highlighting, exactly like the regular background.
vd.themes['rose_pine'] = dict(
    color_default          = '',
    color_default_hdr      = 'bold 5',
    color_bottom_hdr       = 'bold 5',  # the line actually shown for a normal 1-row header
    color_current_row      = 'on 0',    # toned down: no bold, just a subtle Surface1 tint
    color_current_col      = 'on 0',    # same tint as current_row, so row/col highlighting matches
    color_current_cell     = 'on 16',   # the actual cursor cell: forced back to plain Base bg
    color_current_hdr      = 'on 0',
    color_column_sep       = '8',
    color_key_col          = '6',
    color_edit_cell        = '4',
    color_selected_row     = '3',
    color_note_row         = '3',
    color_note_type        = '6',
    color_warning          = '3',
    color_error            = '1',
    color_status           = 'bold on 0',
    color_menu             = '15 on 0',
    color_menu_active      = '0 on 4',
    color_menu_help        = '8 on 0',
    # Status bar bg is dark (Overlay), like the rest of the theme, rather
    # than the stock bright Blue: every accent color used in status spans
    # (yellow selected-count, red errors, green working…) already has good
    # contrast against Overlay elsewhere in this theme, but several of them
    # wash out against a bright Blue bg (e.g. yellow-on-blue, subtext-on-blue
    # both land under 2:1 contrast). 'active' is now indicated with bold
    # Blue (Foam) text instead of a Blue fill.
    color_active_status    = 'bold 4 on 0',
    color_inactive_status  = '7 on 0',
    color_keystrokes       = 'bold 0 on 7',  # the small "which key you pressed" badge
    color_longname_status  = '7',            # the command name shown next to it
    color_working          = 'bold 2',
    color_add_pending      = '2',
    color_change_pending   = 'reverse 3',
    color_delete_pending   = '1',
    color_readonly         = 'on 0',
    color_code             = 'bold 2',       # highlighted/backticked words (e.g. in guide sidebars)
    color_heading          = 'bold 0 on 3',
    # Sidebar (the contextual guide/help box, e.g. the "Enter to open <table>"
    # panel on an index sheet) defaults to a jarring green fill — tone it
    # down to the same subtle Overlay used for current_row, so it reads as
    # part of the theme instead of a garish highlight box.
    color_sidebar          = 'on 0',
    color_sidebar_title    = 'bold 5 on 0',
    plot_colors            = '1 2 3 4 5 6',
)
options.theme = 'rose_pine'   # View menu > Set theme (or Space > theme-input) to browse others

# ── Safety ────────────────────────────────────────────────────────────────────
options.quitguard = True        # confirm before quitting with unsaved changes
options.undo      = True        # U / R to undo/redo (default on, made explicit)

# ── Display ───────────────────────────────────────────────────────────────────
options.disp_menu          = True      # top menu bar
options.disp_splitwin_pct  = 0         # no split pane by default (Z to toggle)
options.disp_float_fmt     = '{:.4f}'  # sensible float precision
options.disp_date_fmt      = '%Y-%m-%d'
options.null_value         = None      # what counts as null for isNull/aggregators
options.wrap               = False     # no wrapping in the text viewer

# ── Data loading ──────────────────────────────────────────────────────────────
options.encoding    = 'utf-8'
options.header      = 1        # first row is the header, for csv/tsv
options.csv_dialect = 'excel'
options.load_lazy   = False    # load sheets eagerly; flip to True for huge files

# ── Analysis ──────────────────────────────────────────────────────────────────
options.histogram_bins = 20    # used by the frequency-table histogram

# ── Integration ───────────────────────────────────────────────────────────────
# Wayland clipboard, matching the rest of this setup (hypr/waybar)
options.clipboard_copy_cmd = 'wl-copy'

# ── Vim-friendly key additions ────────────────────────────────────────────────
# VisiData is already largely vim-like out of the box: hjkl, gg, G, /, n,
# Ctrl+F/Ctrl+B, q. These fill in the few keys vim muscle memory expects that
# VisiData leaves unbound. Nothing here overwrites an existing binding.
vd.bindkey('0',  'go-leftmost')   # same as gh
vd.bindkey('dd', 'cut-row')       # same as x, but vim's spelling

# Deliberately NOT rebound, because VisiData already uses them for its own idioms:
#   u   = unselect-row   (undo is Shift+U, redo is Shift+R)
#   $   = type-currency  (go-rightmost is gl or g$)
#   ^   = rename-col
#   N   = searchr-next    (reverse search already works)
options.disp_float_fmt='{:.4f}'
options.quitguard=True
options.histogram_bins=20
options.numeric_binning=True
