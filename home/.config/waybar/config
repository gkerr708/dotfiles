{
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-top": 2,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "gtk-layer-shell": true,

  "modules-left": [
    //"custom/logo",
    "hyprland/workspaces",
    "hyprland/submap"
    //"hyprland/window"
  ],
  "modules-center": [
    "clock#date",
    "clock#time",
    "custom/weather"
  ],
  "modules-right": [
    //"tray",
	//"mpris",
    //"backlight",
    //"pulseaudio",
	"wireplumber",
    "network",
    "bluetooth",
    "custom/cpu",
    "custom/gpu",
    "custom/vram",
    "memory",
    "custom/power",
    "battery"
  ],

  // --- Left ---
  "custom/logo": {
    "format": "",
    "tooltip": "Waybar for Hyprland",
    "on-click": "wofi --show drun || rofi -show drun",
    "exec-if": "bash -lc 'command -v wofi || command -v rofi'"
  },

  "hyprland/workspaces": {
    "format": "{id} {windows}",              // shows workspace NUMBER, then its windows
    "format-window-separator": " ",          // separator between window entries
    "window-rewrite-default": "?",          // icon when no rule matches
    "window-rewrite": {                      // map classes/titles to icons/text
      "class<kitty>": "",
      "class<firefox>": "",
      "class<brave>": "",
      "title<.*youtube.*>": ""
    },
    "persistent-workspaces": { "*": [1,2,3,4,5,6,7,8] }, // always show 1–5
    "on-click": "hyprctl dispatch workspace {id}"
  },

  "hyprland/submap": { "format": " {name}", "tooltip": true },
  "hyprland/window": { "max-length": 35, "separate-outputs": true, "rewrite": { ".* - Mozilla Firefox": "Firefox" } },

  // --- Center ---
  "clock#date": { "format": "{:%a %b %d}", "tooltip-format": "{:%Y-%m-%d}" },
  "clock#time": { "format": "{:%I:%M %p}", "interval": 1, "tooltip-format": "{:%Z}" }, 


  // --- Right ---
  "tray": { "icon-size": 16, "spacing": 6 },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "mpv": ""
    },
    "format-paused": "{status_icon} {title} - {artist}",
    "status-icons": { "paused": "" },
    "tooltip-format": "{player}: {title}\n{artist} - {album}",
    "ignored-players": ["chromium"],
    "min-length": 28,                        // fixed width so track changes don't shift the bar
    "max-length": 28
  },

  "backlight": {
    "format": "Bri: {percent:>3}",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "MUTE ",
    "format-icons": { "headphone": "", "handsfree": "", "headset": "", "phone": "", "portable": "", "car": "", "default": ["","",""] },
    "on-click": "pavucontrol || pwvucontrol",
    "scroll-step": 2
  },

  "wireplumber": {
    "format": "Vol: {volume:>3}",
    "format-muted": "Vol: ---",
    "on-click": "pwvucontrol",
    "scroll-step": 2
  },

  "network": {
    "format-wifi": "Wifi: {signalStrength:>3}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "format-ethernet": "{ipaddr}",
    "format-disconnected": "󰤮",
    "tooltip": true,
    "on-click": "nm-connection-editor || kitty -e nmtui"
  },

  "bluetooth": {
    "format": "BT: {status}",
    "format-connected": "BT: {num_connections}",
    "tooltip-format": "{controller_alias}\n{device_enumerate}",
	"on-click": "blueman-manager || kitty -e bluetoothctl"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu_stats.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "on-click": "kitty -e btop"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu_stats.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "on-click": "kitty -e btop"
  },

  "custom/vram": {
    "exec": "~/.config/waybar/scripts/vram_stats.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}"
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 900,
    "on-click": "kitty --hold -e curl wttr.in/Halifax,Nova+Scotia"
  },

  "custom/power": {
    "exec": "~/.config/waybar/scripts/power_profile.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/power_profile.sh next; pkill -RTMIN+8 waybar"
  },

  "memory": {
    "interval": 5,
    "format": "RAM: {used:>4.1f}G",
    "tooltip": true
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "format": "Bat: {capacity:>3}",
    "format-icons": ["","","","",""],
    "tooltip": true
  }
}
