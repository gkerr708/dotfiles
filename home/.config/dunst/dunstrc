# dunst: styled to match waybar (black, thin white rounded borders, JetBrainsMono Nerd Font)
[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = 12x40
    width = (280, 380)
    height = 200
    notification_limit = 5
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 8
    separator_height = 0
    transparency = 0

    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = end

    icon_position = left
    max_icon_size = 40
    min_icon_size = 24
    icon_theme = Papirus
    enable_recursive_icon_lookup = true
    icon_corner_radius = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 4

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false

[urgency_low]
    background = "#000000"
    foreground = "#c8c8c8"
    frame_color = "#ffffff80"
    timeout = 4

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ffffffb3"
    highlight = "#a6e3a1"
    timeout = 8

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ff5555"
    highlight = "#ff5555"
    timeout = 0
