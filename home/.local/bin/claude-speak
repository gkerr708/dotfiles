#!/usr/bin/env bash
# claude-speak: control Claude Code's spoken replies.
#   claude-speak on | off | toggle | status   turn speech on/off (stays that way)
#   claude-speak stop                         cut off what's being read now (speech stays on)
#   claude-speak pause                        pause / resume what's being read now
# The Stop hook (claude-speak-hook) only speaks while speech is on.
set -u
FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-speak/enabled"
PLAYER='^paplay --raw --rate=22050'   # anchored: matches only the player itself, never a shell whose command line mentions it

stop_speech() {
    pkill -CONT -f "$PLAYER" 2>/dev/null   # a paused player ignores TERM until resumed
    pkill -x piper-tts 2>/dev/null
    pkill -f "$PLAYER" 2>/dev/null
    true
}

pause_speech() {
    pid=$(pgrep -f "$PLAYER" | head -1)
    [[ -n "$pid" ]] || exit 0
    if [[ "$(ps -o stat= -p "$pid")" == T* ]]; then
        kill -CONT "$pid"          # resume
    else
        kill -STOP "$pid"          # pause (piper just waits on the full pipe)
    fi
}

case "${1:-toggle}" in
    on)     mkdir -p "$(dirname "$FLAG")"; touch "$FLAG"; echo "Claude speech: on" ;;
    off)    rm -f "$FLAG"; stop_speech; echo "Claude speech: off" ;;
    toggle) if [[ -e "$FLAG" ]]; then exec "$0" off; else exec "$0" on; fi ;;
    status) [[ -e "$FLAG" ]] && echo "Claude speech: on" || echo "Claude speech: off" ;;
    stop)   stop_speech ;;
    pause)  pause_speech ;;
    *)      echo "usage: claude-speak on|off|toggle|status|stop|pause" >&2; exit 1 ;;
esac
