#!/usr/bin/env bash
# tmux cheatsheet matching ~/.config/tmux/tmux.conf (prefix is Alt-l).
set -euo pipefail

cat << 'EOF'
===============================
   Tmux Help   (prefix: Alt-l)
===============================

Sessions:
    tmux new -s <name>          # start
    tmux attach -t <name>       # attach
    tmux ls                     # list
    tmux kill-session -t <name>
    tmux kill-server            # kill everything
    Alt-l N                     # new session (prompts for name)
    Alt-l s                     # pick session
    Alt-l d                     # detach

Windows:
    Alt-l c                     # new window (same dir)
    Alt-Left / Alt-Right        # previous / next window (no prefix)
    Alt-l 0..9                  # jump to window
    Alt-l w                     # pick window
    Alt-l t                     # fuzzy-find window (tmux-fzf)

Panes:
    Alt-l %                     # split side by side
    Alt-l "                     # split top / bottom
    Alt-l h/j/k/l               # move left/down/up/right (repeatable)
    Alt-l H/J/K/L               # resize by 5 (repeatable)
    Alt-l R                     # restart pane
    Alt-l x                     # kill pane

Copy mode (vi keys):
    Alt-l n                     # enter copy mode
    v                           # start selection
    y                           # copy to clipboard (wl-copy) and exit
    i                           # exit

Misc:
    Alt-l r                     # reload tmux.conf
    Alt-l Alt-l                 # send Alt-l to the program

===============================
EOF
