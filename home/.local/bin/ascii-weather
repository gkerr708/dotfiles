#!/usr/bin/env python3
"""Animated ASCII weather for the current conditions in Halifax (wttr.in), in Rosé Pine.

Runs in any terminal; ascii-weather-toggle runs it as the desktop background.
    ascii-weather                  # live weather, refreshed every 15 min
    ascii-weather --scene snow     # force a scene: rain storm snow fog cloudy partly sunny night
    ascii-weather --cycle 8        # show every scene for 8 s each (demo)
Quit with q, Esc or Ctrl+C.
"""
import argparse
import json
import math
import os
import random
import select
import shutil
import signal
import sys
import termios
import threading
import time
import tty
import urllib.request
from datetime import datetime
from pathlib import Path

URL = 'https://wttr.in/Halifax,Nova+Scotia?format=j1'
CACHE = Path('~/.cache/ascii-weather.json').expanduser()
REFRESH = 15 * 60
FPS = 12

# Rosé Pine
PINE, FOAM, IRIS, ROSE = (49, 116, 143), (156, 207, 216), (196, 167, 231), (235, 188, 186)
LOVE, GOLD, MUTED, SUBTLE, TEXT = (235, 111, 146), (246, 193, 119), (110, 106, 134), (144, 140, 170), (224, 222, 244)
OVERLAY = (38, 35, 58)

# WWO weather codes -> scenes (same groups as waybar/scripts/weather.sh)
STORM = {200, 386, 389, 392, 395}
SNOW = {179, 182, 185, 227, 230, 281, 284, 311, 314, 317, 320, 323, 326, 329, 332, 335, 338,
        350, 362, 365, 368, 371, 374, 377}
FOG = {143, 248, 260}
CLOUDY = {119, 122}
SCENES = ['rain', 'storm', 'snow', 'fog', 'cloudy', 'partly', 'sunny', 'night']

CLOUD_ART = [
    ['    .--.    ',
     ' .-(    ).  ',
     '(___.__)__) '],
    ['      _  _       ',
     '   ( `   )_     ',
     '  (    )    `)  ',
     '(_   (_ .  _) _)'],
    ['   .-~~~-.   ',
     ' .(        ). ',
     '(___________) '],
]
SUN_FRAMES = [
    ['      \\    |    /      ',
     '        .-----.        ',
     '  ---  (       )  ---  ',
     "        '-----'        ",
     '      /    |    \\      '],
    ['    .     \'     .     ',
     '     \\  .-----.  /     ',
     ' --    (       )    -- ',
     "     /  '-----'  \\     ",
     "    '     ,     '      "],
]
MOON_ART = ['   _.._  ',
            " .' .-'` ",
            '/  /     ',
            '|  |     ',
            "\\  '.___.;",
            " '._  _.' ",
            '    ``    ']


# ---------------------------------------------------------------- weather data

class Weather:
    def __init__(self):
        self.scene, self.caption = self._fallback(), ''
        self.wind = 0
        self._load(self._read_cache())

    @staticmethod
    def _fallback():
        return 'night' if not 7 <= datetime.now().hour < 19 else 'cloudy'

    @staticmethod
    def _read_cache():
        try:
            return json.loads(CACHE.read_text())
        except (OSError, ValueError):
            return None

    def _load(self, j):
        if not j:
            return
        try:
            c = j['current_condition'][0]
            code = int(c['weatherCode'])
            astro = j['weather'][0]['astronomy'][0]
            now = datetime.now().time()
            rise = datetime.strptime(astro['sunrise'], '%I:%M %p').time()
            sset = datetime.strptime(astro['sunset'], '%I:%M %p').time()
            day = rise <= now < sset
            if code in STORM:
                scene = 'storm'
            elif code in SNOW:
                scene = 'snow'
            elif code in FOG:
                scene = 'fog'
            elif code == 113:
                scene = 'sunny' if day else 'night'
            elif code == 116:
                scene = 'partly' if day else 'night'
            elif code in CLOUDY:
                scene = 'cloudy'
            else:
                scene = 'rain'
            desc = c['weatherDesc'][0]['value'].strip().lower()
            self.scene, self.wind = scene, int(c.get('windspeedKmph', 0))
            self.caption = f"halifax  {c['temp_C']}°c  {desc}"
        except (KeyError, IndexError, ValueError):
            pass

    def refresh_forever(self):
        while True:
            try:
                with urllib.request.urlopen(URL, timeout=10) as r:
                    j = json.load(r)
                CACHE.parent.mkdir(parents=True, exist_ok=True)
                CACHE.write_text(json.dumps(j))
                self._load(j)
            except Exception:
                pass                       # offline: keep the last known weather
            time.sleep(REFRESH)


# ---------------------------------------------------------------- canvas

class Canvas:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.chars = [[' '] * w for _ in range(h)]
        self.cols = [[None] * w for _ in range(h)]

    def put(self, x, y, ch, col):
        x, y = int(x), int(y)
        if 0 <= x < self.w and 0 <= y < self.h and ch != ' ':
            self.chars[y][x] = ch
            self.cols[y][x] = col

    def text(self, x, y, s, col, transparent=True):
        for i, ch in enumerate(s):
            if ch != ' ' or not transparent:
                self.put(x + i, y, ch, col)

    def art(self, x, y, lines, col, solid=False):
        for dy, line in enumerate(lines):
            if solid and line.strip():
                a = len(line) - len(line.lstrip())
                for i in range(a, len(line.rstrip())):
                    self.erase(x + i, y + dy)
            self.text(x, y + dy, line, col)

    def erase(self, x, y):
        x, y = int(x), int(y)
        if 0 <= x < self.w and 0 <= y < self.h:
            self.chars[y][x] = ' '

    def render(self):
        out = ['\x1b[H']
        last = None
        for y in range(self.h):
            row = self.chars[y]
            cols = self.cols[y]
            for x in range(self.w):
                c = cols[x]
                if c != last and row[x] != ' ':
                    out.append(f'\x1b[38;2;{c[0]};{c[1]};{c[2]}m')
                    last = c
                out.append(row[x])
            if y < self.h - 1:
                out.append('\r\n')
        return ''.join(out)


def dim(c, f):
    return tuple(int(v * f) for v in c)


# ---------------------------------------------------------------- scenes

class Scene:
    def __init__(self, kind, w, h, wind):
        self.kind, self.w, self.h, self.wind = kind, w, h, wind
        self.t = 0
        area = w * h
        r = random.random
        heavy = kind == 'storm'
        self.drops = [[r() * w, r() * h, 0.9 + r() * 1.1, r()] for _ in range(area // (18 if heavy else 40))] \
            if kind in ('rain', 'storm') else []
        self.flakes = [[r() * w, r() * h, 0.12 + r() * 0.3, r() * 6.3, random.choice('**.+')]
                       for _ in range(area // 45)] if kind == 'snow' else []
        self.pile = [0.0] * w
        self.splashes = []
        self.bolt, self.next_bolt = [], self.t + random.randint(40, 120)
        self.stars = [(int(r() * w), int(r() * h * 0.85), r() * 6.3, 0.02 + r() * 0.06)
                      for _ in range(area // 70)] if kind == 'night' else []
        self.shooting = None
        n_clouds = {'cloudy': max(3, w // 30), 'fog': max(2, w // 50), 'partly': max(2, w // 45),
                    'night': max(1, w // 80), 'rain': max(2, w // 50), 'storm': max(3, w // 40),
                    'snow': max(1, w // 70)}.get(kind, 0)
        self.clouds = [[r() * w, 1 + r() * max(1, h * 0.35), 0.03 + r() * 0.09, random.choice(CLOUD_ART)]
                       for _ in range(n_clouds)]
        self.fog = [[r() * w, 3 + r() * (h - 6), 0.05 + r() * 0.15, random.randint(w // 6, w // 2)]
                    for _ in range(h // 3)] if kind == 'fog' else []
        self.birds = []

    # each step draws one frame
    def step(self, cv):
        self.t += 1
        getattr(self, f'_{self.kind}')(cv)

    def _draw_clouds(self, cv, col):
        for c in self.clouds:
            c[0] += c[2]
            width = len(c[3][0])
            if c[0] > cv.w:
                c[0] = -width
            cv.art(c[0], c[1], c[3], col, solid=True)

    def _rain(self, cv, heavy=False):
        slant = -1 if self.wind > 20 else 0
        ch = '/' if slant else '|'
        for d in self.drops:
            d[1] += d[2]
            d[0] += slant * d[2] * 0.6
            if d[1] >= cv.h - 1:
                self.splashes.append([d[0], cv.h - 1, 3])
                d[0], d[1] = random.random() * (cv.w + 20), -random.random() * 5
            col = FOAM if d[3] > 0.85 else PINE if d[3] > 0.3 else dim(PINE, 0.7)
            cv.put(d[0], d[1], ch, col)
            if d[2] > 1.5:
                cv.put(d[0] - slant, d[1] - 1, ch, dim(col, 0.5))
        for s in self.splashes:
            s[2] -= 1
            cv.put(s[0], s[1], '.' if s[2] > 1 else ',', dim(FOAM, 0.6))
            if s[2] == 2:
                cv.put(s[0] - 1, s[1], '`', dim(PINE, 0.6))
                cv.put(s[0] + 1, s[1], "'", dim(PINE, 0.6))
        self.splashes = [s for s in self.splashes if s[2] > 0]
        self._draw_clouds(cv, dim(MUTED, 0.8))

    def _storm(self, cv):
        self._rain(cv, heavy=True)
        if self.t >= self.next_bolt:
            x, y = random.randint(cv.w // 6, cv.w * 5 // 6), 0
            path = []
            end = random.randint(cv.h // 2, cv.h - 2)
            while y < end:
                step = random.choice((-1, 0, 1))
                path.append((x, y, '/' if step < 0 else '\\' if step > 0 else '|'))
                x += step
                y += 1
            self.bolt, self.bolt_ttl = path, 4
            self.next_bolt = self.t + random.randint(FPS * 4, FPS * 12)
        if self.bolt:
            col = TEXT if self.bolt_ttl > 2 else GOLD
            for x, y, ch in self.bolt:
                cv.put(x, y, ch, col)
            self.bolt_ttl -= 1
            if self.bolt_ttl <= 0:
                self.bolt = []

    def _snow(self, cv):
        cap = max(2, cv.h // 8)
        for f in self.flakes:
            f[1] += f[2]
            f[0] += math.sin(self.t * 0.05 + f[3]) * 0.25 - self.wind * 0.004
            x = int(f[0]) % cv.w
            ground = cv.h - 1 - int(self.pile[x])
            if f[1] >= ground:
                if self.pile[x] < cap:
                    self.pile[x] += 0.15
                f[0], f[1] = random.random() * cv.w, -1
            cv.put(f[0] % cv.w, f[1], f[4], TEXT if f[4] == '*' else SUBTLE)
        for x, hgt in enumerate(self.pile):
            full = int(hgt)
            for i in range(full):
                cv.put(x, cv.h - 1 - i, ':' if i < full - 1 else '.', dim(TEXT, 0.55))
        if self.t % FPS == 0:                     # slowly settle so it never fills up
            self.pile = [max(0.0, p - 0.01) for p in self.pile]
        self._draw_clouds(cv, dim(MUTED, 0.7))

    def _fog(self, cv):
        self._draw_clouds(cv, dim(MUTED, 0.6))
        for band in self.fog:
            band[0] += band[2]
            if band[0] > cv.w:
                band[0] = -band[3]
            for i in range(band[3]):
                wave = math.sin((i + self.t * 0.3) * 0.25)
                ch = '~' if wave > 0.3 else '-' if wave > -0.4 else ' '
                cv.put(band[0] + i, band[1], ch, dim(SUBTLE, 0.45))

    def _cloudy(self, cv):
        self._draw_clouds(cv, SUBTLE)

    def _sun(self, cv):
        frame = SUN_FRAMES[(self.t // 7) % 2]
        sx, sy = cv.w - len(frame[0]) - 4, 2
        for dy, line in enumerate(frame):
            for i, ch in enumerate(line):
                body = ch in "().-'" and 7 <= i <= 15 and 1 <= dy <= 3
                cv.put(sx + i, sy + dy, ch, GOLD if body else dim(GOLD, 0.6))

    def _birds(self, cv):
        if random.random() < 0.004:
            self.birds.append([-3.0, 3 + random.random() * cv.h * 0.4, 0.25 + random.random() * 0.2])
        for b in self.birds:
            b[0] += b[2]
            wing = 'v' if (self.t // 4) % 2 else '-'
            cv.text(b[0], b[1], f'\\{wing}/' if wing == '-' else 'v', dim(TEXT, 0.6))
        self.birds = [b for b in self.birds if b[0] < cv.w + 3]

    def _sunny(self, cv):
        self._sun(cv)
        self._birds(cv)

    def _partly(self, cv):
        self._sun(cv)
        self._draw_clouds(cv, SUBTLE)
        self._birds(cv)

    def _night(self, cv):
        for x, y, phase, speed in self.stars:
            b = (math.sin(self.t * speed + phase) + 1) / 2
            ch = '*' if b > 0.92 else '+' if b > 0.7 else '.' if b > 0.25 else ' '
            cv.put(x, y, ch, IRIS if b > 0.92 else dim(SUBTLE, 0.4 + b * 0.5))
        cv.art(cv.w - 18, 2, MOON_ART, dim(TEXT, 0.85), solid=True)
        self._draw_clouds(cv, dim(MUTED, 0.5))
        if self.shooting is None and random.random() < 0.003:
            self.shooting = [random.random() * cv.w * 0.6, random.random() * cv.h * 0.3, 0]
        if self.shooting:
            s = self.shooting
            s[0] += 2.2
            s[1] += 0.6
            s[2] += 1
            cv.put(s[0], s[1], '*', TEXT)
            for i in range(1, 6):
                cv.put(s[0] - i * 2.2, s[1] - i * 0.6, '-' if i < 3 else '.', dim(IRIS, 1 - i * 0.15))
            if s[2] > 25 or s[0] > cv.w:
                self.shooting = None


# ---------------------------------------------------------------- main loop

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--scene', choices=SCENES, help='force a scene instead of live weather')
    ap.add_argument('--cycle', type=float, metavar='SECONDS', help='rotate through every scene')
    ap.add_argument('--no-caption', action='store_true', help='hide the bottom-right caption')
    args = ap.parse_args()

    weather = Weather()
    if not args.scene and not args.cycle:
        threading.Thread(target=weather.refresh_forever, daemon=True).start()

    out = sys.stdout
    out.write('\x1b[?1049h\x1b[?25l\x1b[2J')
    out.flush()
    keys = sys.stdin.fileno() if sys.stdin.isatty() else None
    saved = termios.tcgetattr(keys) if keys is not None else None
    if keys is not None:
        tty.setcbreak(keys)                       # read q / Esc without waiting for Enter

    def restore(*_):
        if saved:
            termios.tcsetattr(keys, termios.TCSADRAIN, saved)
        out.write('\x1b[0m\x1b[?25h\x1b[?1049l')
        out.flush()
        sys.exit(0)
    signal.signal(signal.SIGTERM, restore)
    signal.signal(signal.SIGINT, restore)

    scene, key, start = None, None, time.time()
    try:
        while True:
            t0 = time.time()
            w, h = shutil.get_terminal_size()
            if args.cycle:
                kind = SCENES[int((t0 - start) // args.cycle) % len(SCENES)]
            else:
                kind = args.scene or weather.scene
            if (kind, w, h) != key:
                scene, key = Scene(kind, w, h, weather.wind), (kind, w, h)
                out.write('\x1b[2J')
            cv = Canvas(w, h)
            scene.step(cv)
            caption = f'{kind}' if (args.scene or args.cycle) else weather.caption
            if caption and not args.no_caption:
                cv.text(w - len(caption) - 2, h - 1, caption, dim(SUBTLE, 0.8), transparent=False)
            out.write(cv.render())
            out.flush()
            wait = max(0.0, 1 / FPS - (time.time() - t0))
            if keys is not None and select.select([keys], [], [], wait)[0]:
                if os.read(keys, 32)[:1] in (b'q', b'Q', b'\x1b'):
                    break
            else:
                time.sleep(wait if keys is None else 0)
    finally:
        restore()


if __name__ == '__main__':
    main()
