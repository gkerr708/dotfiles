#!/bin/bash
# Build and flash the Corne (RP2040 / Blok) keymap, one half at a time.
# Put each half in bootloader mode when asked; the script mounts the RPI-RP2 drive
# and copies the .uf2 for you.
set -euo pipefail

QMK_HOME="${QMK_HOME:-$HOME/qmk_firmware}"
KEYBOARD="crkbd"
KEYMAP="gkerr708-gaming"
HALVES=2
BUILD=1
TIMEOUT=300   # seconds to wait for each half

usage() {
  cat <<EOF
Usage: corne-flash [options]

  -k, --keymap NAME   keymap to build (default: $KEYMAP)
  -n, --halves N      how many halves to flash, 1 or 2 (default: $HALVES)
  -1                  shorthand for --halves 1
  -s, --skip-build    flash the existing .uf2 without recompiling
  -t, --timeout SEC   seconds to wait for each half (default: $TIMEOUT)
  -h, --help          show this help

Per half: unplug it, then plug it back in holding BOOT and tapping RESET
(or hold the top-left key for the left half). Let go once it says "mounted".
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -k|--keymap)     KEYMAP="$2"; shift 2 ;;
    -n|--halves)     HALVES="$2"; shift 2 ;;
    -1)              HALVES=1; shift ;;
    -s|--skip-build) BUILD=0; shift ;;
    -t|--timeout)    TIMEOUT="$2"; shift 2 ;;
    -h|--help)       usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$HALVES" in 1|2) ;; *) echo "--halves must be 1 or 2" >&2; exit 2 ;; esac
for cmd in qmk udisksctl lsblk; do
  command -v "$cmd" >/dev/null || { echo "Missing dependency: $cmd" >&2; exit 1; }
done
[ -d "$QMK_HOME" ] || { echo "QMK folder not found: $QMK_HOME" >&2; exit 1; }

UF2="$QMK_HOME/${KEYBOARD}_rev1_${KEYMAP}.uf2"

if [ "$BUILD" -eq 1 ]; then
  echo "Building $KEYBOARD:$KEYMAP ..."
  (cd "$QMK_HOME" && qmk compile -kb "$KEYBOARD" -km "$KEYMAP" >/dev/null) \
    || { echo "Build failed. Run: qmk compile -kb $KEYBOARD -km $KEYMAP" >&2; exit 1; }
  echo "Build OK."
fi
[ -f "$UF2" ] || { echo "Firmware not found: $UF2" >&2; exit 1; }

find_boot_drive() {
  lsblk -rno PATH,LABEL | awk '$2=="RPI-RP2"{print $1; exit}'
}

for half in $(seq "$HALVES"); do
  echo
  echo "[$half/$HALVES] Put a half in bootloader mode (unplug, replug holding BOOT + tapping RESET)..."
  dev=""
  for _ in $(seq "$TIMEOUT"); do
    dev=$(find_boot_drive)
    [ -n "$dev" ] && break
    sleep 1
  done
  [ -n "$dev" ] || { echo "Timed out waiting for half $half." >&2; exit 1; }
  sleep 1

  mp=$(lsblk -rno MOUNTPOINT "$dev" | head -1)
  if [ -z "$mp" ]; then
    udisksctl mount -b "$dev" >/dev/null
    mp=$(lsblk -rno MOUNTPOINT "$dev" | head -1)
  fi
  echo "    mounted at $mp"

  cp "$UF2" "$mp"/
  sync
  echo "    flashed. Let go of the keys; it reboots by itself."

  # Wait for the drive to disappear so the next half isn't mistaken for this one.
  for _ in $(seq 30); do
    [ -z "$(find_boot_drive)" ] && break
    sleep 1
  done
done

echo
echo "Done. Test: switch to the HLL layer (right half) and Caps Lock on the number layer (left half)."
